+ load:function(){
+  return Promise.all([uci.changes(),callPriority().catch(function(e){return {ready:false,message:e.message};})]);
+ },
+ render:function(data){
+  var state=data[1]||{},self=this;
+  this.prioritySelect=E('select',{'id':'boot-priority'},[
+   E('option',{'value':'sd'},_('SD / TF 卡优先')),
+   E('option',{'value':'flash'},_('Flash 官方系统优先'))
+  ]);
+  if(state.priority!=='sd'&&state.priority!=='flash')
+   this.prioritySelect.insertBefore(E('option',{'value':''},_('未读取')),this.prioritySelect.firstChild);
+  this.prioritySelect.value=state.priority||'';
+  this.priorityMessage=E('p',{'class':state.ready?'alert-message notice':'alert-message warning'},state.message||_('无法读取启动优先级。'));
+  this.priorityButton=E('button',{'class':'cbi-button cbi-button-action','click':ui.createHandlerFn(this,'handlePrioritySave')},_('保存启动优先级'));
+  // LuCI E() stringifies false attributes; use DOM properties for booleans.
+  this.prioritySelect.disabled=!state.ready;
+  this.priorityButton.disabled=!state.ready;
+  this.savedPriority=state.priority;
+  this.priorityPending=false;this.priorityUncertain=false;
+  this.prioritySelect.addEventListener('change',function(){self.updateReturnHint();});
+  this.returnHint=E('p',{'class':'cbi-value-description'});
+  this.updateReturnHint();
+  var body=E([
+   E('h2',_('Reboot')),
+   E('p',{},_('Reboots the operating system of your device'))
+  ]);
+  for(var config in (data[0]||{})){
+   body.appendChild(E('p',{'class':'alert-message warning'},_('Warning: There are unsaved changes that will get lost on reboot!')));break;
+  }
+  body.appendChild(E('button',{'class':'cbi-button cbi-button-action important','click':ui.createHandlerFn(this,'handleReboot')},_('Perform reboot')));
+  body.appendChild(E('section',{'class':'cbi-section'},[
+   E('h3',{},_('启动优先级')),
+   E('p',{},_('选择重启时优先尝试的系统。设置会持续生效，保存不会立即重启。')),
+   E('div',{'class':'cbi-value'},[
+    E('label',{'class':'cbi-value-title','for':'boot-priority'},_('优先启动')),
+    E('div',{'class':'cbi-value-field'},[this.prioritySelect,this.returnHint])
+   ]),
+   this.priorityMessage,this.priorityButton
+  ]));
+  return body;
+ },
+ updateReturnHint:function(){
+  if(!this.returnHint)return;
+  this.returnHint.textContent=this.prioritySelect.value==='flash'
+   ?_('选择 Flash 后，后续重启仍优先进入官方系统。需要返回 TF 系统时，请在官方系统的启动设置中改回 SD 优先。')
+   :_('优先启动已插入的 SD / TF 卡系统。');
+ },
+ handlePrioritySave:function(){
+  var wanted=this.prioritySelect.value;
+  if(wanted!=='sd'&&wanted!=='flash')return;
+  this.prioritySelect.disabled=true;
+  this.priorityPending=true;
+  this.priorityButton.disabled=true;
+  this.priorityMessage.textContent=_('正在保存并校验启动优先级…');
+  return savePriority(wanted).then(L.bind(function(result){
+   if(!result||!result.success||!result.ready||result.priority!==wanted)
+    throw new Error(result&&result.message||_('启动优先级保存失败，请勿重启。'));
+   this.savedPriority=result.priority;
+   this.priorityUncertain=false;
+   this.priorityMessage.className='alert-message notice';
+   this.priorityMessage.textContent=result.message;
+  },this)).catch(L.bind(function(e){
+   this.priorityUncertain=true;
+   this.priorityMessage.className='alert-message warning';
+   this.priorityMessage.textContent=e.message;
+  },this)).finally(L.bind(function(){
+   this.priorityPending=false;
+   this.prioritySelect.disabled=false;this.priorityButton.disabled=false;
+  },this));
+ },
+ showRebootWait:function(){
+  ui.showModal(_('Rebooting…'),[E('p',{'class':'spinning'},_('Waiting for device...'))]);
+  L.ui.awaitReconnect();
+ },
+ handleReboot:function(){
+  if(this.priorityPending||this.priorityUncertain){
+   ui.addNotification(null,E('p',{},_('启动设置尚未完成或校验失败，请先检查，暂不重启。')));return;
+  }
+  if(this.savedPriority&&this.prioritySelect.value!==this.savedPriority){
+   ui.addNotification(null,E('p',{},_('启动优先级尚未保存，请先保存或恢复原选项。')));return;
+  }
+  return callReboot().then(L.bind(function(result){
+   if(result!==0)throw new Error(_('The reboot command failed with code %d').format(result));
+   this.showRebootWait();
+  },this)).catch(function(e){ui.addNotification(null,E('p',{},e.message));});
+ },
+ handleSaveApply:null,handleSave:null,handleReset:null
