			</div></div>
			<footer class="cpe-footer"><span>C2000MAX CPE · LuCI {{ version.luciversion }}</span><ul class="breadcrumb" id="modemenu" style="display:none"></ul></footer>
		</div>
	</div>
	<script>var luciLocation = {{ ctx.path }};</script>
