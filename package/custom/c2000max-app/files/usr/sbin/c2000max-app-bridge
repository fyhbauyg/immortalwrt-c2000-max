#!/bin/sh

. /usr/share/libubox/jshn.sh

STATE_DIR=/var/run/c2000max-app
CONF="$STATE_DIR/mosquitto.conf"
LOG="$STATE_DIR/mosquitto.log"
BRIDGE_STATE="$STATE_DIR/bridge.state"
BRIDGE_SESSION_STATE="$STATE_DIR/bridge-session.state"
BRIDGE_RECONNECT_COUNT="$STATE_DIR/bridge-reconnect.count"
LOCAL_PORT=1884
SESSION_RESTART_INTERVAL="$(uci -q get c2000max_app.main.bridge_restart_interval)"
case "$SESSION_RESTART_INTERVAL" in
	''|*[!0-9]*) SESSION_RESTART_INTERVAL=86400 ;;
esac
[ "$SESSION_RESTART_INTERVAL" -ge 3600 ] || SESSION_RESTART_INTERVAL=3600
[ "$SESSION_RESTART_INTERVAL" -le 172800 ] || SESSION_RESTART_INTERVAL=172800

umask 077
mkdir -p "$STATE_DIR" || exit 2
chmod 0755 "$STATE_DIR"

bridge_state()
{
	state="$1"
	message="$2"
	printf '{"state":"%s","message":"%s","updated":%s}\n' \
		"$state" "$message" "$(date +%s)" > "$BRIDGE_STATE"
	chmod 0600 "$BRIDGE_STATE"
}

bridge_session_state()
{
	state="$1"
	message="$2"
	session_started="${3:-0}"
	printf '{"state":"%s","message":"%s","session_started":%s,"reconnect_count":%s,"reconnect_interval":%s,"updated":%s}\n' \
		"$state" "$message" "$session_started" "$reconnect_count" \
		"$SESSION_RESTART_INTERVAL" "$(date +%s)" > "$BRIDGE_SESSION_STATE"
	chmod 0600 "$BRIDGE_SESSION_STATE"
}

fail()
{
	bridge_state error "$1"
	exit 2
}

identity="$(/usr/sbin/c2000max-app-remote identity 2>/dev/null)"
device_id="$(printf '%s' "$identity" | jsonfilter -e '@.device_id')"
broker="$(printf '%s' "$identity" | jsonfilter -e '@.broker')"
available="$(printf '%s' "$identity" | jsonfilter -e '@.available')"
bdinfo_present="$(printf '%s' "$identity" | jsonfilter -e '@.bdinfo_present')"
bdinfo_identity_valid="$(printf '%s' "$identity" | jsonfilter -e '@.bdinfo_identity_valid')"
remote_identity_available="$(printf '%s' "$identity" | jsonfilter -e '@.remote_identity_available')"
device_code_present="$(printf '%s' "$identity" | jsonfilter -e '@.device_code_present')"

case "$device_id" in
	????????????) ;;
	*) fail "invalid device identity" ;;
esac
[ "$available" = true ] || fail "device identity unavailable"
[ "$bdinfo_present" = true ] || fail "bdinfo unavailable"
[ "$bdinfo_identity_valid" = true ] || fail "bdinfo identity invalid"
[ "$remote_identity_available" = true ] || fail "remote identity unavailable"
[ "$device_code_present" = true ] || fail "device code unavailable"
[ "$broker" = "$device_id.dev.nradio.com.cn" ] || fail "broker identity mismatch"

reconnect_sequence="$(cat "$BRIDGE_RECONNECT_COUNT" 2>/dev/null)"
case "$reconnect_sequence" in
	''|*[!0-9]*) reconnect_sequence=0 ;;
esac
reconnect_sequence=$((reconnect_sequence + 1))
reconnect_count=$((reconnect_sequence - 1))
printf '%s\n' "$reconnect_sequence" > "$BRIDGE_RECONNECT_COUNT"
chmod 0600 "$BRIDGE_RECONNECT_COUNT"

rm -f "$LOG"

# Do not mirror routine connect/reconnect notices into tmpfs.  A live remote
# bridge previously grew this file beyond 4 MiB per session.
{
	printf '%s\n' \
		'per_listener_settings false' \
		"listener $LOCAL_PORT 127.0.0.1" \
		'allow_anonymous true' \
		'persistence false' \
		'connection_messages false' \
		'log_timestamp true' \
		"log_dest file $LOG" \
		'log_type error' \
		'log_type warning' \
		"connection $device_id" \
		"address $broker:1883" \
		'bridge_protocol_version mqttv311' \
		"remote_clientid $device_id" \
		'remote_username router' \
		'keepalive_interval 10' \
		'cleansession false' \
		'notifications true' \
		'notifications_local_only true' \
		'restart_timeout 5' \
		'start_type automatic' \
		'try_private false' \
		"topic kp/mosca/$device_id/# out 1 \"\" \"\"" \
		"topic kp/$device_id/+/# in 1 \"\" \"\""

	if [ "$(uci -q get c2000max_app.main.broadcast_enable)" = 1 ]; then
		printf '%s\n' \
			"topic mosca/# in 1 kp/$device_id/ kp/FFFFFFFFFFFF/"
	fi

	if [ "$(uci -q get c2000max_app.main.command_enable)" = 1 ] ||
	   [ "$(uci -q get c2000max_app.main.developer_enable)" = 1 ]; then
		printf '%s\n' \
			"topic exec/# both 1 rpc/ $device_id/"
	fi

	if [ "$(uci -q get c2000max_app.main.device_report_enable)" = 1 ] ||
	   [ "$(uci -q get c2000max_app.main.signal_report_enable)" = 1 ] ||
	   [ "$(uci -q get c2000max_app.main.traffic_report_enable)" = 1 ] ||
	   [ "$(uci -q get c2000max_app.main.terminal_tracking_enable)" = 1 ]; then
		printf '%s\n' \
			"topic sysinfo/# out 1 \"\" $device_id/"
	fi
} > "$CONF" || exit 2

chmod 600 "$CONF"
touch "$LOG"
chmod 600 "$LOG"
if id mosquitto >/dev/null 2>&1; then
	chown mosquitto:mosquitto "$CONF" "$LOG"
fi

# BEGIN BRIDGE SUPERVISION
# procd supervises this shell, not its grandchildren.  Wait on an asynchronous
# timeout so ash can run the stop trap immediately; a foreground command would
# defer the trap and leave the listener orphaned when procd kills this shell.
bridge_child_pid=

stop_bridge_child()
{
	[ -n "$bridge_child_pid" ] || return 0
	# A completed wait may already have reaped the PID.  Never signal a recycled
	# PID: only our still-owned, direct timeout child may receive this TERM.
	if read -r child_stat < "/proc/$bridge_child_pid/stat" 2>/dev/null; then
		child_stat="${child_stat##*) }"
		set -- $child_stat
		if [ "$2" = "$$" ]; then
			kill -TERM "$bridge_child_pid" 2>/dev/null || :
		fi
	fi
	# GNU timeout forwards TERM to its own broker process group.  Its -k 15
	# remains active while we reap it, including when a broker ignores TERM.
	wait "$bridge_child_pid" 2>/dev/null || :
	bridge_child_pid=
}

stop_bridge()
{
	trap '' TERM INT HUP
	# Cover TERM arriving between the asynchronous launch and the $! assignment.
	# This is the script's only background job; ownership is checked above.
	bridge_child_pid="${bridge_child_pid:-$!}"
	stop_bridge_child
	bridge_state stopped "official MQTT bridge stopped"
	bridge_session_state stopped "official MQTT bridge stopped" 0
	exit 0
}

trap stop_bridge_child EXIT
trap stop_bridge TERM INT HUP

bridge_state starting "local broker and official bridge starting"
bridge_session_state starting "new official MQTT session starting" 0

/usr/bin/timeout -s TERM -k 15 "$SESSION_RESTART_INTERVAL" \
	/usr/sbin/mosquitto -c "$CONF" &
bridge_child_pid=$!
wait "$bridge_child_pid"
result=$?
bridge_child_pid=

if [ "$result" -eq 124 ]; then
	bridge_state reconnecting "scheduled official MQTT session refresh"
	bridge_session_state reconnecting \
		"scheduled official MQTT session refresh" 0
	# procd respawns only this bridge instance.  Local HTTP, routing, QModem and
	# the rest of the device remain untouched.
	exit 1
fi

bridge_session_state stopped "official MQTT bridge exited" 0
exit "$result"
# END BRIDGE SUPERVISION
