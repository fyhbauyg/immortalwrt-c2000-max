#!/usr/bin/lua

local nixio = require "nixio"
local uci = require("luci.model.uci").cursor()
local core = require "c2000max_app.core"
local cloud = require "c2000max_app.cloud"

if not core.remote_enabled() then
	os.exit(0)
end

local presence_interval = tonumber(uci:get("c2000max_app", "main",
	"presence_interval") or "2") or 2
if presence_interval < 2 then
	presence_interval = 2
elseif presence_interval > 60 then
	presence_interval = 60
end

local status_interval = tonumber(uci:get("c2000max_app", "main",
	"status_interval") or "30") or 30
if status_interval < 10 then
	status_interval = 10
elseif status_interval > 300 then
	status_interval = 300
end

local report_interval = tonumber(uci:get("c2000max_app", "main",
	"report_interval") or "300") or 300
if report_interval < 60 then
	report_interval = 60
elseif report_interval > 3600 then
	report_interval = 3600
end

local function clock()
	-- NTP can move wall time after boot. A backwards correction must not
	-- postpone reports for hours, nor should a forward one create a burst.
	local info = type(nixio.sysinfo) == "function" and nixio.sysinfo() or nil
	return type(info) == "table" and tonumber(info.uptime) or os.time()
end

nixio.nanosleep(10)
local next_status = 0
local next_reports = 0
local next_presence = 0
local previous_clock = clock()
local presence_stream

local function close_presence_stream()
	if presence_stream then
		pcall(presence_stream.close, presence_stream)
		presence_stream = nil
	end
end

local function publish_presence()
	if not presence_stream then
		presence_stream = cloud.open_cpe_status_publisher()
	end
	if presence_stream and
	   cloud.publish_cpe_status_stream(presence_stream) then
		return true
	end
	close_presence_stream()
	-- Preserve compatibility if the long-lived publisher cannot start.
	return cloud.publish_cpe_status()
end

while core.remote_enabled() do
	local now = clock()
	if now < previous_clock then
		next_presence, next_status, next_reports = now, now, now
	end
	previous_clock = now
	-- Each user-configured cadence has its own deadline. For example a
	-- 60-second presence interval must not turn a 10-second status interval
	-- into a 60-second one. Calls remain serial and never catch up in bursts.
	if now >= next_presence then
		publish_presence()
		next_presence = clock() + presence_interval
	end
	if now >= next_status then
		cloud.publish_online_status()
		next_status = clock() + status_interval
	end
	if now >= next_reports then
		cloud.publish_reports()
		next_reports = clock() + report_interval
	end
	-- Factory report_proactively emits cpestatus about every two seconds.
	-- Keep this behind the user's signal-report permission.
	now = clock()
	nixio.nanosleep(math.max(1,
		math.min(next_presence, next_status, next_reports) - now))
end

close_presence_stream()
