#!/bin/sh
# A single initial/recovered 5G link may restart the optional controller.
# Its runtime supervisor handles route/device loss without touching HNAT.
case "$ACTION" in
	ifup) ;;
	ifupdate) [ "$IFUPDATE_ROUTES" = 1 ] || exit 0 ;;
	*) exit 0 ;;
esac
[ "$DEVICE" = eth2 ] || exit 0
[ "$(uci -q get c2000max_nrqos.main.enabled)" = 1 ] || exit 0
/etc/init.d/c2000max-nrqos restart >/dev/null 2>&1
