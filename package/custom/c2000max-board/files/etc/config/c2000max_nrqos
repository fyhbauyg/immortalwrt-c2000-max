# Disabled by default. 130000 kbit/s is a user-specific initial ceiling based
# on the reported 150 Mbit/s upload, not a measured busy-hour NR minimum.
config main 'main'
	option enabled '0'
	option interface 'eth2'
	option upload_kbit '130000'
	option download_enabled '1'
	option download_kbit '130000'
	option min_download_kbit '0'
	option max_download_kbit '0'
	option autorate '0'
	option min_upload_kbit '0'
	option max_upload_kbit '0'
	option interval '3'
	option delay_target_ms '15'
	list ping_hosts '223.5.5.5'
	list ping_hosts '119.29.29.29'
