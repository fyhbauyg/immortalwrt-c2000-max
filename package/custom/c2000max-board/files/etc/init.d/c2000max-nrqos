#!/bin/sh /etc/rc.common
# Optional TF userspace service. No HNAT, SPI-NOR, MTD or bootenv writes.
START=97
STOP=15
USE_PROCD=1

start_service()
{
	[ "$(uci -q get c2000max_nrqos.main.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/c2000max-nrqos run
	procd_set_param file /etc/config/c2000max_nrqos
	procd_set_param term_timeout 8
	procd_set_param stdout 0
	procd_set_param stderr 1
	# No respawn loop: unsupported topology/configuration must remain visible
	# as a stopped service, not repeatedly replace the user's root qdisc.
	procd_close_instance
}

stop_service()
{
	/usr/sbin/c2000max-nrqos stop
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_trigger c2000max_nrqos sqm eqos c2000max network
}
