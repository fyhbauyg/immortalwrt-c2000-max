#!/bin/sh /etc/rc.common

START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	# One worker owns both signal status and derived scheduled-off state.
	# It snapshots before suppressing LEDs and never rewrites the manual switch.
	procd_set_param command /usr/sbin/c2000max-leds
	procd_set_param respawn 5 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger c2000max qmodem system
}
