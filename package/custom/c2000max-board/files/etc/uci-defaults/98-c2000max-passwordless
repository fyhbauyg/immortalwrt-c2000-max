#!/bin/sh

# C2000MAX images intentionally ship without a LuCI/SSH root password.  Run
# after preserved sysupgrades too, because the defective factory-overlay build
# could have imported the stock firmware's password hash into /etc/shadow.
passwd -d root >/dev/null 2>&1 ||
	sed -i 's|^root:[^:]*:|root::|' /etc/shadow

root_field="$(sed -n 's/^root:\([^:]*\):.*/\1/p' /etc/shadow | head -n 1)"
[ -z "$root_field" ] || exit 1

exit 0
