#!/bin/sh
# One-shot, read-only diagnostic. No UCI writes, AT commands or service reloads.

check_overlap()
{
	awk -F '\t' '
	function ipv4(s, a,n,i,v) {
	 n=split(s,a,"."); if(n!=4) return -1; v=0;
	 for(i=1;i<=4;i++) { if(a[i]!~/^[0-9]+$/ || a[i]>255) return -1; v=v*256+a[i] }
	 return v
	}
	{ name[NR]=$1; addr[NR]=$2; mask[NR]=$3 }
	END {
	 for(i=1;i<=NR;i++) if(name[i]=="lan") {
	  l=ipv4(addr[i]); if(l<0 || mask[i]!~/^[0-9]+$/ || mask[i]>32) continue;
	  for(j=1;j<=NR;j++) if(name[j]!="lan") {
	   r=ipv4(addr[j]); if(r<0 || mask[j]!~/^[0-9]+$/ || mask[j]>32) continue;
	   p=mask[i]<mask[j]?mask[i]:mask[j]; d=2^(32-p);
	   if(int(l/d)==int(r/d)) printf "WARNING: LAN %s/%s overlaps uplink %s %s/%s\n", addr[i],mask[i],name[j],addr[j],mask[j];
	  }
	 }
	}'
}

[ "${C2000_NETCHECK_SOURCE_ONLY:-0}" != 1 ] || return 0
date -Iseconds
uptime
grep -E '^(BUILD|MEMORY_PROFILE|FACTORY_FLASH_ACCESS)=' /etc/c2000max-build
grep -E '^(MemAvailable|MemFree|AnonPages|Cached|Slab|SReclaimable|SUnreclaim|SwapFree|VmallocUsed):' /proc/meminfo
printf '\nLAN/uplink overlap check (no output = none found):\n'
ubus call network.interface dump | jq -r '
 .interface[] | select(.interface == "lan" or any(.route[]?; .target == "0.0.0.0" and .mask == 0)) |
 .interface as $name | .["ipv4-address"][]? | [$name, .address, .mask] | @tsv' | check_overlap
printf '\nIPv4 routing:\n'
ip -4 rule
ip -4 route show table all
printf '\nAcceleration / queue conflicts:\n'
cat /var/run/c2000max-hnat-effective /sys/kernel/debug/hnat/hook_toggle /sys/kernel/debug/hnat/hnat_topology 2>/dev/null
. /usr/lib/c2000max/qos-compat.sh
if c2000_sqm_enabled; then
	printf 'SQM enabled: offload must be disabled; EQoS must be paused.\n'
	[ "$(cat /sys/kernel/debug/hnat/hook_toggle 2>/dev/null)" != enabled ] || printf 'WARNING: SQM is being bypassed by HNAT\n'
	[ ! -s /var/run/eqos/backend ] || printf 'WARNING: SQM and EQoS both have runtime state\n'
fi
printf '\nEthernet link/counters:\n'
for dev in eth1 eth2; do
	[ -d "/sys/class/net/$dev" ] || continue
	printf '%s ' "$dev"
	for stat in speed duplex carrier; do
		printf '%s=%s ' "$stat" "$(cat /sys/class/net/$dev/$stat 2>/dev/null)"
	done
	printf '\n'
	for stat in rx_packets tx_packets rx_crc_errors rx_errors tx_errors rx_dropped tx_dropped; do
		printf '%s=%s ' "$stat" "$(cat /sys/class/net/$dev/statistics/$stat)"
	done
	printf '\n'
done
printf '\nWi-Fi stations (PHY rate is not application throughput):\n'
iw dev
for dev in ra0 rai0 ra1 rai1; do
	[ -d "/sys/class/net/$dev" ] || continue
	iw dev "$dev" station dump | grep -E 'Station|signal:|tx bitrate:|rx bitrate:|tx retries:|tx failed:|connected time:'
done
printf '\nCPU IRQ distribution:\n'
grep -E 'CPU|ethernet|xhci|wed|IPI' /proc/interrupts
printf '\n5G software TX queue:\n'
tc -s qdisc show dev eth2 2>/dev/null
printf '\nRecent serious kernel diagnostics:\n'
dmesg | grep -Ei 'WARNING:|BUG: |Oops:|out of memory|oom-kill|watchdog.*timeout|field-spanning|I/O error' | tail -n 30
exit 0
