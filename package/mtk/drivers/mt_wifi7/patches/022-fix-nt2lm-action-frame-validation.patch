From: C2000MAX local driver maintenance
Subject: [PATCH 022] Validate NT2LM action frames and accept default mapping

Pass actual received length into the AP/STA NT2LM receive path and reuse
the bounded format parser from patch 021. Keep the existing bidirectional,
complete-contract policy. Validate on a candidate before replacing live maps,
and normalize default maps to established links. Do not add token matching,
pending-request state, scheduled or partial-TID negotiation in this patch.

Preserve all eight TX maps, fix the IE payload length and presence bitmap,
and encode link maps and response status with the proper little-endian width.

diff --git a/mt_wifi/common/action.c b/mt_wifi/common/action.c
index bbcc540..38b362a 100644
--- a/mt_wifi/common/action.c
+++ b/mt_wifi/common/action.c
@@ -1996,13 +1996,19 @@ static void eht_peer_mld_link_reconfig_action(
 
 VOID PeerProtectEHTAction(PRTMP_ADAPTER pAd, MLME_QUEUE_ELEM *Elem)
 {
-	struct eht_prot_action_frame *eht_prot_act = (struct eht_prot_action_frame *)Elem->Msg;
-	UINT8 Action = eht_prot_act->prot_eht_action, *pos;
-	struct wifi_dev *wdev = Elem->wdev;
+	struct eht_prot_action_frame *eht_prot_act;
+	UINT8 Action, *pos;
+	struct wifi_dev *wdev;
 	MAC_TABLE_ENTRY *pEntry = NULL;
 	struct mld_entry_t *mld_entry = NULL;
 	uint16_t mld_sta_idx, mld_link_num;
 
+	if (!Elem || Elem->MsgLen < sizeof(struct eht_prot_action_frame))
+		return;
+	eht_prot_act = (struct eht_prot_action_frame *)Elem->Msg;
+	Action = eht_prot_act->prot_eht_action;
+	wdev = Elem->wdev;
+
 	if (!VALID_UCAST_ENTRY_WCID(pAd, Elem->Wcid) || !wdev)
 		return;
 
