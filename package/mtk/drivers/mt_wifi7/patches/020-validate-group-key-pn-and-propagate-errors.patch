+struct mtk_pn_reply_context {
+	CMD_WTBL_PN_T request[MAX_TSC_TYPE];
+	CMD_WTBL_PN_T reply[MAX_TSC_TYPE];
+	UINT32 count;
+	UINT16 hw_wcid;
+	UINT8 operation;
+	BOOLEAN valid;
+};
+
+static VOID UniCmdPnReply(struct cmd_msg *msg, char *payload, UINT16 len)
+{
+	struct mtk_pn_reply_context *ctx = (VOID *)msg->attr.rsp.wb_buf_in_calbk;
+
+	if (!ctx)
+		return;
+	ctx->valid = FALSE;
+	if (ctx->operation == QUERY_WTBL)
+		ctx->valid = mtk_pn_parse_reply((UCHAR *)payload, len, ctx->hw_wcid,
+			ctx->request, ctx->count, ctx->reply);
+	else if (ctx->operation == SET_WTBL)
+		ctx->valid = mtk_pn_parse_result((UCHAR *)payload, len, UNI_CMD_ID_STAREC_INFO);
+}
