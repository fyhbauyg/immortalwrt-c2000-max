+++ b/mt_wifi/include/common/security/pn_reply.h
@@ -0,0 +1,64 @@
+/* Strict, transactional validation for the existing unified PN wire format. */
+#ifndef __MTK_PN_REPLY_H__
+#define __MTK_PN_REPLY_H__
+
+static inline UINT16 mtk_pn_le16(const UCHAR *p)
+{
+	return (UINT16)p[0] | ((UINT16)p[1] << 8);
+}
+
+static inline BOOLEAN mtk_pn_parse_reply(const UCHAR *payload, UINT32 len,
+	UINT16 hw_wcid, const CMD_WTBL_PN_T *request, UINT32 count,
+	CMD_WTBL_PN_T *output)
+{
+	CMD_WTBL_PN_T checked[MAX_TSC_TYPE];
+	UINT32 i, j, seen = 0;
+	const UCHAR *tlv;
+
+	if (!payload || !request || !output || !count || count > MAX_TSC_TYPE)
+		return FALSE;
+	if (len != sizeof(UNI_EVENT_STAREC_T) +
+		count * sizeof(UNI_CMD_STAREC_SEC_PN_INFO_T))
+		return FALSE;
+	if (mtk_pn_le16(payload) != hw_wcid)
+		return FALSE;
+
+	for (i = 0; i < count; i++) {
+		if (request[i].ucTscType >= MAX_TSC_TYPE)
+			return FALSE;
+		for (j = 0; j < i; j++)
+			if (request[i].ucTscType == request[j].ucTscType)
+				return FALSE;
+		checked[i] = request[i];
+	}
+	for (i = 0; i < count; i++) {
+		tlv = payload + sizeof(UNI_EVENT_STAREC_T) +
+			i * sizeof(UNI_CMD_STAREC_SEC_PN_INFO_T);
+		if (mtk_pn_le16(tlv) != UNI_EVENT_STAREC_SEC_PN_INFO ||
+			mtk_pn_le16(tlv + 2) != sizeof(UNI_CMD_STAREC_SEC_PN_INFO_T))
+			return FALSE;
+		for (j = 0; j < count; j++)
+			if (request[j].ucTscType == tlv[10])
+				break;
+		if (j == count || (seen & (1U << j)))
+			return FALSE;
+		seen |= 1U << j;
+		memcpy(checked[j].aucPn, tlv + 4, sizeof(checked[j].aucPn));
+	}
+	if (seen != (1U << count) - 1)
+		return FALSE;
+	/* No caller-visible partial result, including on a malformed later TLV. */
+	os_move_mem(output, checked, count * sizeof(*output));
+	return TRUE;
+}
+
+static inline BOOLEAN mtk_pn_parse_result(const UCHAR *payload, UINT32 len,
+	UINT16 command)
+{
+	if (!payload || len != sizeof(struct UNI_EVENT_CMD_RESULT_T))
+		return FALSE;
+	return mtk_pn_le16(payload) == command &&
+		payload[4] == 0 && payload[5] == 0 && payload[6] == 0 && payload[7] == 0;
+}
+
+#endif /* __MTK_PN_REPLY_H__ */
