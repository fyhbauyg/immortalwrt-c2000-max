	config MTK_HWIFI_BLACKHAWK_A0
		bool "blackhawk_a0"
		select PACKAGE_kmod-blackhawk_a0
		depends on PACKAGE_kmod-mt_hwifi
	config MTK_HWIFI_BLACKHAWK_A0_PCIE1
		bool "blackhawk_a0_pcie1"
		select PACKAGE_kmod-blackhawk_a0_pcie1
		depends on PACKAGE_kmod-blackhawk_a0
endmenu

endif #PACKAGE_kmod-mt_hwifi#
