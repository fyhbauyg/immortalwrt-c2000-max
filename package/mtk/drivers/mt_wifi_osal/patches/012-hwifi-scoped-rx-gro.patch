+/* SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause */
+#ifndef MT_OSAL_RX_GRO_H
+#define MT_OSAL_RX_GRO_H
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+
+/* Stack lifetime: begin/end must surround one synchronous RX batch. */
+struct mt_os_rx_gro_scope {
+ struct sk_buff_head frames;
+ struct napi_struct *napi;
+ struct mt_os_rx_gro_scope *previous;
+};
+bool mt_os_rx_gro_begin(struct mt_os_rx_gro_scope *scope,
+                      struct napi_struct *napi);
+void mt_os_rx_gro_end(struct mt_os_rx_gro_scope *scope);
+#endif
