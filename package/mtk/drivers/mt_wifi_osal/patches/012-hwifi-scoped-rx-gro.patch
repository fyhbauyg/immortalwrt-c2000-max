+/* Opt-in until hardware A/B and forwarding validation are complete. */
+static bool rx_gro;
+module_param(rx_gro, bool, 0644);
+MODULE_PARM_DESC(rx_gro, "Batch synchronous HWIFI RX delivery through NAPI GRO");
+static DEFINE_PER_CPU(struct mt_os_rx_gro_scope *, mt_os_rx_scope);
+
+bool mt_os_rx_gro_begin(struct mt_os_rx_gro_scope *scope,
+                      struct napi_struct *napi)
+{
+ if (!READ_ONCE(rx_gro) || !napi || !in_serving_softirq() ||
+     in_hardirq() || in_nmi())
+  return false;
+ /* Pin the stack-owned scope even on preemptible configurations. */
+ preempt_disable();
+ __skb_queue_head_init(&scope->frames);
+ scope->napi = napi;
+ scope->previous = this_cpu_read(mt_os_rx_scope);
+ this_cpu_write(mt_os_rx_scope, scope);
+ return true;
+}
+EXPORT_SYMBOL(mt_os_rx_gro_begin);
+
+void mt_os_rx_gro_end(struct mt_os_rx_gro_scope *scope)
+{
+ struct sk_buff *skb;
+
+ /* Protocol callbacks must not enqueue back into the draining scope. */
+ this_cpu_write(mt_os_rx_scope, NULL);
+ while ((skb = __skb_dequeue(&scope->frames)) != NULL)
+  napi_gro_receive(scope->napi, skb);
+ this_cpu_write(mt_os_rx_scope, scope->previous);
+ preempt_enable();
+}
+EXPORT_SYMBOL(mt_os_rx_gro_end);
