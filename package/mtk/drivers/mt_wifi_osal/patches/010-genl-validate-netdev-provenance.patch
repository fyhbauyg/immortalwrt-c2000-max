+bool mt_os_net_dev_is_osal(void *net_dev)
+{
+	struct net_device *dev = net_dev;
+	const struct net_device_ops *ops;
+
+	if (!dev)
+		return false;
+
+	/* Check registration provenance before accessing the private allocation. */
+	ops = dev->netdev_ops;
+	return ops && ops->ndo_get_stats == mt_os_net_dev_get_ether_stats &&
+		ops->ndo_do_ioctl == mt_os_wifi_ioctl;
+}
